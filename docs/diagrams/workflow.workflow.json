  "edges": [
    {
      "id": "task-size",
      "from": "task",
      "to": "size"
    },
    {
      "id": "size-scout",
      "from": "size",
      "to": "scout",
      "label": "lookups",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "size-plan",
      "from": "size",
      "to": "plan",
      "label": "M / L",
      "variant": "emphasis"
    },
    {
      "id": "plan-spec",
      "from": "plan",
      "to": "specrev",
      "label": "L: spec",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "plan-impl",
      "from": "plan",
      "to": "impl",
      "label": "confirmed",
      "variant": "emphasis"
    },
    {
      "id": "impl-debug",
      "from": "impl",
      "to": "debug",
      "label": "fails twice",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "impl-tests",
      "from": "impl",
      "to": "tests"
    },
    {
      "id": "debug-tests",
      "from": "debug",
      "to": "tests",
      "label": "root cause fixed",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "tests-review",
      "from": "tests",
      "to": "review",
      "label": "full diff",
      "variant": "emphasis"
    },
    {
      "id": "review-impl",
      "from": "review",
      "to": "impl",
      "label": "findings · ≤2 rounds",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "review-pr",
      "from": "review",
      "to": "pr",
      "label": "gate green",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Tiers",
      "items": [
        "S: ≤3 files, known approach — implement directly",
        "M: 4–10 files — checkbox plan in docs/superpowers/plans/",
        "L: schema, payments, auth or unknown cause — spec first"
      ]
    },
    {
      "dot": "rose",
      "title": "Gates",
      "items": [
        "code-reviewer on every PR; security-auditor on sensitive paths",
        "review-gate hook reminds at gh pr create",
        "verify hook: tsc + related tests before Stop"
      ]
    }
  ]
}
